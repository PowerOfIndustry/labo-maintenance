    {
        "id": "c5703763ad05845a",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "Évaluer seuils",
        "func": "const seuils = {\n  \"ns=1;s=Temperature\": { alerte: 71.5, alarme: 78,   h: 1.5 },\n  \"ns=1;s=Vibration\":   { alerte: 2.75, alarme: 3.0,  h: 0.15 },\n  \"ns=1;s=Courant\":     { alerte: 15.5, alarme: 16, h: 0.3 },\n  \"ns=1;s=Pression\": { alerte: 6.3, alarme: 6.8, h: 0.3 },\n  \"ns=1;s=Heures\": { alerte: 450, alarme: 500, h: 0 }\n}\n\n\nconst s = seuils[msg.topic];\nif (!s) {\n  node.warn(`Aucun seuil défini pour ${msg.topic}`);\n  return null;\n}\n\nconst v = msg.payload;\nconst etats = context.get(\"etats\") || {};\nconst precedent = etats[msg.topic] || \"NORMAL\";\n\nlet niveau = \"NORMAL\";\nif (v >= s.alarme) niveau = \"ALARME\";\nelse if (v >= s.alerte) niveau = \"ALERTE\";\n\nif (precedent === \"ALARME\" && niveau !== \"ALARME\" && v > s.alarme - s.h) niveau = \"ALARME\";\nif (precedent !== \"NORMAL\" && niveau === \"NORMAL\" && v > s.alerte - s.h) niveau = \"ALERTE\";\n\n\n\n\n\netats[msg.topic] = niveau;\ncontext.set(\"etats\", etats);\n\nmsg.niveau = niveau;\nmsg.payload = `${msg.topic.split(\"=\").pop()} = ${v.toFixed(2)} → ${niveau}`;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1240,
        "y": 520,
        "wires": [
            [
                "c79c2f388dcc389f",
                "414a1e4c064f17ba"
            ]
        ]
